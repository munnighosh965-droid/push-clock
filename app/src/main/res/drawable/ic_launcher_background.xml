<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Obsidian field, lit slightly from above so the mark sits on a
         surface rather than a flat block of colour. -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:startColor="#1A2028"
                android:endColor="#07090C" />
        </aapt:attr>
    </path>
    <!-- Warm halo behind the dial. -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="40"
                android:startColor="#26E4C58A"
                android:endColor="#00E4C58A" />
        </aapt:attr>
    </path>
</vector>
