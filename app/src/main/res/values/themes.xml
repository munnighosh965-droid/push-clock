<resources>
    <style name="Theme.PowerClock" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/obsidian</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.PowerClock.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/obsidian</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.PowerClock</item>
    </style>

    <style name="Theme.PowerClock.Ringing" parent="Theme.PowerClock">
        <item name="android:windowBackground">@color/obsidian</item>
    </style>
</resources>
